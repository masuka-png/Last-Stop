  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d062825b1ce6fe0448c668c37795879b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  entries:
  - key: Cube
    lines:
    - Hello sir, how do you do? I am a humble cube of Cubetopia, pleasure to meet
      you.
  - key: Squeaky
    lines:
    - Hey man, do you know what time it is?
    - Oh my watch is broken thats why. And the clock in here stopped working last
      month
    - Yeah I dropped it in the fryer. Sometimes I wonder if I should drop myself
      in.
